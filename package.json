{
  "name": "siomac-netlify-supabase",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "npm run build:backend:clean && cross-env NODE_OPTIONS=--max-old-space-size=16384 npx netlify-cli dev",
    "build": "npm run build:backend && npm run build:frontend:clean",
    "build:backend": "tsc -p netlify/functions/tsconfig.json",
    "clean:backend": "node -e \"const fs=require('fs');for(const p of ['dist/netlify','dist/.tsbuildinfo-functions'])fs.rmSync(p,{recursive:true,force:true})\"",
    "build:backend:clean": "npm run clean:backend && tsc -p netlify/functions/tsconfig.json",
    "build:frontend": "vite build",
    "clean:frontend": "node -e \"const fs=require('fs'),pa=require('path'),d='dist';for(const f of ['assets','sw.js','sw.js.map','registerSW.js','index.html','manifest.webmanifest'])fs.rmSync(pa.join(d,f),{recursive:true,force:true});try{for(const f of fs.readdirSync(d))if(f.startsWith('workbox-'))fs.rmSync(pa.join(d,f),{force:true})}catch(e){}\"",
    "build:frontend:clean": "npm run clean:frontend && vite build",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "tsc -p netlify/functions/tsconfig.json --noEmit",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit",
    "lint:frontend": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:frontend": "vitest",
    "test:frontend:ui": "vitest --ui",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:e2e:coverage": "node scripts/e2e/coverage-gate.mjs",
    "test:e2e:sweep": "node scripts/e2e/sweep-orphans.mjs --apply",
    "seed:hr-dashboard": "node scripts/seed-hr-employee-master-dashboard.mjs",
    "repo:index": "node scripts/generate-codebase-index.mjs --write",
    "repo:index:check": "node scripts/generate-codebase-index.mjs --check",
    "gen:types": "supabase gen types typescript --project-id YOUR_PROJECT_ID > types/supabase-generated.ts",
    "prepare": "husky",
    "lint:backend": "eslint netlify/functions --ext .ts",
    "lint": "npm run lint:frontend && npm run lint:backend"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "target": "ES2022",
            "module": "CommonJS",
            "esModuleInterop": true,
            "strict": true,
            "skipLibCheck": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "netlify/functions/lib/**/*.ts",
      "netlify/functions/routes/**/*.ts"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@motionone/dom": "^10.18.0",
    "@netlify/functions": "^2.0.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@supabase/supabase-js": "2.105.3",
    "@tanstack/preact-query": "^5.100.10",
    "@tanstack/query-core": "^5.100.10",
    "@types/qrcode": "^1.5.6",
    "@types/react-grid-layout": "^1.3.6",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.2",
    "chart.js": "^4.5.1",
    "dotenv": "17.4.2",
    "fflate": "^0.8.3",
    "flatpickr": "^4.6.13",
    "hono": "^4.12.27",
    "jsonwebtoken": "^9.0.2",
    "lucide": "^1.20.0",
    "motion": "^11.18.2",
    "openai": "^6.45.0",
    "otplib": "^13.4.0",
    "pdfkit": "^0.19.1",
    "preact": "^10.29.2",
    "qrcode": "^1.5.4",
    "react-grid-layout": "^1.5.3",
    "resend": "^6.14.0",
    "rrule": "^2.8.1",
    "sortablejs": "^1.15.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/flatpickr": "^3.0.2",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/ui": "^4.1.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.0",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint --quiet --no-warn-ignored",
    "netlify/functions/**/*.ts": "eslint --quiet --no-warn-ignored"
  }
}
