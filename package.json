{
  "name": "siomac-netlify-supabase",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "npm run build:backend:clean && npx netlify-cli dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p netlify/functions/tsconfig.json",
    "clean:backend": "node -e \"const fs=require('fs');for(const p of ['dist/netlify','dist/.tsbuildinfo-functions'])fs.rmSync(p,{recursive:true,force:true})\"",
    "build:backend:clean": "npm run clean:backend && tsc -p netlify/functions/tsconfig.json",
    "build:frontend": "vite build",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "tsc -p netlify/functions/tsconfig.json --noEmit",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit",
    "lint:frontend": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:frontend": "vitest",
    "test:frontend:ui": "vitest --ui",
    "gen:types": "supabase gen types typescript --project-id YOUR_PROJECT_ID > types/supabase-generated.ts"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "esModuleInterop": true,
            "strict": true,
            "skipLibCheck": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "netlify/functions/lib/**/*.ts",
      "netlify/functions/routes/**/*.ts"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@netlify/functions": "^2.0.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/preact-query": "^5.100.10",
    "@tanstack/query-core": "^5.100.10",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.2",
    "flatpickr": "^4.6.13",
    "hono": "^4.7.10",
    "jsonwebtoken": "^9.0.2",
    "lucide": "^1.20.0",
    "otplib": "^13.4.0",
    "preact": "^10.29.2",
    "qrcode": "^1.5.4",
    "resend": "^6.14.0",
    "sortablejs": "^1.15.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/flatpickr": "^3.0.2",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/ui": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jsdom": "^29.1.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.0",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
