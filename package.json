{
  "name": "siomac-netlify-supabase",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run build && npx netlify-cli dev",
    "build": "tsc -p netlify/functions/tsconfig.json",
    "typecheck": "tsc -p netlify/functions/tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "dist/netlify/functions/lib/**/*.js",
      "dist/netlify/functions/routes/**/*.js"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@netlify/functions": "^2.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.7.10",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.0"
  }
}
