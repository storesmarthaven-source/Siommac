# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# These are inlined into the browser bundle at build time.
# They are PUBLIC — never put secrets here.

# Your Supabase project URL (found in: Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose; RLS policies enforce security
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: override API base URL (leave blank to use same-origin /api/*)
# VITE_API_BASE=

# Optional: app display name (defaults to "Siomac")
# VITE_APP_NAME=Siomac


# ─── Backend (Netlify Functions) ──────────────────────────────────────────────
# Set these in Netlify > Site settings > Environment variables.
# NEVER commit real values.

# Supabase project URL (same value as VITE_SUPABASE_URL — repeated for server)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role key — has full DB access, server-side only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase anon key (also needed server-side for Realtime / client calls)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT signing secret (min 32 chars, generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-string

# AES-256-GCM key for encrypting TOTP secrets (exactly 64 hex chars = 32 bytes)
# Generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=change_me_to_a_random_64_char_hex_string

# App timezone (IANA zone name)
APP_TZ=America/Port_of_Spain
