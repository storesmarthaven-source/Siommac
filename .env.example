# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# These are inlined into the browser bundle at build time.
# They are PUBLIC — never put secrets here.

# Your Supabase project URL (found in: Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose; RLS policies enforce security
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: override API base URL (leave blank to use same-origin /api/*)
# VITE_API_BASE=

# Optional: app display name (defaults to "Siomac")
# VITE_APP_NAME=Siomac


# ─── Backend (Netlify Functions) ──────────────────────────────────────────────
# Set these in Netlify > Site settings > Environment variables.
# NEVER commit real values.

# Supabase project URL (same value as VITE_SUPABASE_URL — repeated for server)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role key — has full DB access, server-side only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase anon key (also needed server-side for Realtime / client calls)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT_SECRET and TOTP_ENCRYPTION_KEY removed — Supabase Auth now manages
# all session tokens and MFA secrets. No custom JWT signing is needed.

# Realtime-auth (optional — messenger falls back to polling when unset).
# SIOMAC-controlled ES256 signing key: generate the keypair, import the JWK in
# the Supabase dashboard (JWT Keys → import) and rotate it to CURRENT, then set:
#   SUPABASE_JWT_ES256_KID         = the imported key's kid (uuid)
#   SUPABASE_JWT_ES256_PRIVATE_KEY = base64 of the PKCS8 PEM private key
# BACKEND-ONLY — never expose via VITE_/PUBLIC_ vars. Do NOT use the legacy
# HS256 shared secret. See RUNBOOK_REALTIME_AUTH.md.
#SUPABASE_JWT_ES256_KID=
#SUPABASE_JWT_ES256_PRIVATE_KEY=

# App timezone (IANA zone name)
APP_TZ=America/Port_of_Spain

# Messenger compliance evidence hashing. Generate a dedicated random value of
# at least 32 characters. Do not reuse JWT, trusted-device, or service-role
# secrets. Rotation requires a new versioned variable and matching migration so
# historical evidence keeps its key-version provenance.
COMPLIANCE_EVIDENCE_PEPPER_V1=replace-with-at-least-32-random-characters

# Payslip Studio (template-driven payslip PDF rendering). DEFAULT OFF.
# While unset/false, production payroll always renders payslips with the
# snapshot-binding pdfkit layout — never a Studio design. Only set to "true"
# once a run's chosen template design binds its earnings/deductions table and
# summary totals to the pay-run snapshot (Phase-2 completion), otherwise a
# template's static figures could print on a real payslip.
# PAYSLIP_STUDIO_ENABLED=false

# OpenAI API key — server-side only, used by profile-photo/enhance (AI photo
# enhancement). Missing key → the route returns 503 with a clear message.
OPENAI_API_KEY=sk-...

# ─── Phase 2f — External notifications ───────────────────────────────────────
# All four are optional. Missing keys → that delivery channel is silently skipped.

# Resend (email delivery) — https://resend.com → API Keys
RESEND_API_KEY=re_...
# Sender address shown in the "From" header. Must be a verified domain in Resend.
# REQUIRED for any email send — there is deliberately NO fallback sender in code, because an
# unverified default would fail every send at the provider instead of failing loudly at config.
RESEND_FROM_EMAIL=Siomac <no-reply@yourdomain.com>
# Optional. Where replies go if it differs from the sender. Omitted → no Reply-To header.
RESEND_REPLY_TO=
# Signing secret for the Resend webhook (Resend → Webhooks → Signing Secret), verified against the
# RAW request body. Without it the delivery lifecycle stops at "sent": only a verified webhook may
# set delivered/bounced/complained, so `delivered_at` stays null and reconciliation reports
# delivery confirmation as unavailable rather than flagging every message as stuck.
# ⚠ A locally generated value only satisfies the local tests; the REAL secret exists once the
# webhook is created against a publicly reachable deployment.
RESEND_WEBHOOK_SECRET=whsec_...

# Optional. Base URL for published email artwork. Defaults to the public `branding/email` bucket in
# SUPABASE_URL. Set this to move email assets behind a CDN without touching a single stored
# template — authors write /assets/images/email/..., the server resolves it at send time.
# Publish the assets with: npm run email:publish-assets
EMAIL_ASSET_BASE_URL=

# Meta WhatsApp Business Cloud API — https://developers.facebook.com/apps
# Phone number ID: Business Manager → WhatsApp → API Setup → Phone number ID
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Long-lived permanent access token (generate in Meta Business Suite → System Users)
WHATSAPP_ACCESS_TOKEN=EAAxxxxx...
