{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "../../dist",
    "rootDir": "../..",
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": "../../dist/.tsbuildinfo-functions"
  },
  "include": [
    "./**/*.ts",
    "../../types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
