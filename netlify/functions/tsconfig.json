{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "../../dist",
    "rootDir": "../..",
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": "../../dist/.tsbuildinfo-functions"
  },
  "include": [
    "./**/*.ts",
    "../../types/**/*.ts",
    // The Studio's MJML renderer is shared, not duplicated: production sending must compile from
    // the SAME renderer the editor uses, or what arrives differs from what was designed. It is
    // pure string-building (no DOM, no preact), which is what makes it server-safe.
    "../../src/lib/emailTemplateDocument.ts",
    // Icon rendering is shared for the same reason, and additionally feeds the asset publisher:
    // scripts/publish-email-assets.mjs rasterizes from THIS list and THIS palette, so the icons
    // that exist in the bucket cannot drift from the icons the renderer is willing to emit.
    "../../src/lib/emailIcons.ts",
    // The starter-template catalogue, shared with the Studio's dev adapter so the browser and the
    // server-side store cannot disagree about what a template is.
    "../../src/lib/emailTemplateSeeds.ts"
  ],
  "exclude": ["node_modules"]
}
